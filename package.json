{
  "name": "llm-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"hooks/**/*.test.ts\" \"ci/**/*.test.ts\"",
    "test:tap": "node --import tsx --test --test-reporter=tap \"src/**/*.test.ts\" \"hooks/**/*.test.ts\" \"ci/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "start": "node --import tsx src/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
